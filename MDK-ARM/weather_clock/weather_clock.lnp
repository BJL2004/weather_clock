--cpu Cortex-M3
"weather_clock\startup_stm32f103xe.o"
"weather_clock\main.o"
"weather_clock\gpio.o"
"weather_clock\usart.o"
"weather_clock\stm32f1xx_it.o"
"weather_clock\stm32f1xx_hal_msp.o"
"weather_clock\stm32f1xx_hal_gpio_ex.o"
"weather_clock\stm32f1xx_hal_uart.o"
"weather_clock\stm32f1xx_hal.o"
"weather_clock\stm32f1xx_hal_rcc.o"
"weather_clock\stm32f1xx_hal_rcc_ex.o"
"weather_clock\stm32f1xx_hal_gpio.o"
"weather_clock\stm32f1xx_hal_dma.o"
"weather_clock\stm32f1xx_hal_cortex.o"
"weather_clock\stm32f1xx_hal_pwr.o"
"weather_clock\stm32f1xx_hal_flash.o"
"weather_clock\stm32f1xx_hal_flash_ex.o"
"weather_clock\stm32f1xx_hal_exti.o"
"weather_clock\system_stm32f1xx.o"
"weather_clock\led.o"
"weather_clock\uart.o"
